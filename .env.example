# Codex2Lark local Gateway configuration.
# Copy to .env, replace every required placeholder, then run commands with:
# uv run --env-file .env codex2lark <command>

# Required: Feishu application credentials.
CODEX2LARK_FEISHU_APP_ID=cli_replace_me
CODEX2LARK_FEISHU_APP_SECRET=replace_me

# Required: OpenAI Responses API or a compatible provider.
# OPENAI_API_KEY contains the selected provider's key.
OPENAI_API_KEY=replace_me
# Current local example: DeepSeek's Responses-compatible endpoint and model.
OPENAI_BASE_URL=https://api.deepseek.com
CODEX2LARK_MODEL=deepseek-v4-flash
# Current provider prices in micro-US-dollars per one million tokens.
CODEX2LARK_MODEL_INPUT_COST_MICROS_PER_MILLION_TOKENS=replace_with_current_price
CODEX2LARK_MODEL_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=replace_with_current_price

# Required: generate once with `openssl rand -base64 32` and back it up safely.
CODEX2LARK_MASTER_KEY_ID=local-v1
CODEX2LARK_MASTER_KEY_BASE64=replace_with_base64_encoded_32_byte_key

# Optional runtime identity and storage location.
CODEX2LARK_AUTHORING_IDENTITY=user
# Uncomment with an absolute path to override the platform user-state directory.
# CODEX2LARK_DATA_DIR=/absolute/path/to/codex2lark-state

# Optional admission allowlists. Empty means all joined groups/human members.
CODEX2LARK_ENABLED_CHAT_IDS=
CODEX2LARK_AUTHORIZED_ACTOR_IDS=

# Optional execution budgets and scheduling limits.
CODEX2LARK_RUN_WALL_TIME_MS=900000
CODEX2LARK_RUN_COST_LIMIT_MICROS=1000000
CODEX2LARK_TASK_CONCURRENCY=4
CODEX2LARK_TENANT_CONCURRENCY=4
CODEX2LARK_APP_CONCURRENCY=4
CODEX2LARK_GROUP_CONCURRENCY=2
CODEX2LARK_MODEL_PROVIDER_CONCURRENCY=4
CODEX2LARK_PLUGIN_CONCURRENCY=4
CODEX2LARK_POLL_INTERVAL_MS=200
CODEX2LARK_SHUTDOWN_DRAIN_MS=30000

# Optional encrypted local-storage limits.
CODEX2LARK_STORAGE_MAX_BYTES=10737418240
CODEX2LARK_STORAGE_MIN_FREE_BYTES=536870912
# Inclusive per-file download limit: 200 MiB by default.
CODEX2LARK_MAX_ATTACHMENT_BYTES=209715200

# Optional canary rollout. Keep disabled unless every enabled value is configured.
CODEX2LARK_CANARY_PERCENT=0
CODEX2LARK_CANARY_AGENT_VERSION=
CODEX2LARK_ROLLOUT_SALT=
CODEX2LARK_CANARY_MODEL=
